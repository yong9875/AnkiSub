# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large binaries (prevent committing 70MB+ exe to git repository)
bin/*.exe
!bin/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary & Log files
*.log
*.tmp
temp/
test/
